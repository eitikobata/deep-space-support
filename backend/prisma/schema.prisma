generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREW
  OFFICER
}

enum AlertLevel {
  BLUE_ALERT
  YELLOW_ALERT
  RED_ALERT
}

enum TransmissionStatus {
  ACTIVE
  UNDER_REVIEW
  RESOLVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  transmissions Transmission[] @relation("SentTransmissions")
  logEntries    LogEntry[]     @relation("OfficerLogEntries")
}

model Tag {
  id            String         @id @default(uuid())
  name          String         @unique
  transmissions Transmission[]
}

model Transmission {
  id          String             @id @default(uuid())
  subject     String
  description String
  alertLevel  AlertLevel         @default(BLUE_ALERT)
  status      TransmissionStatus @default(ACTIVE)
  senderId    String
  sender      User               @relation("SentTransmissions", fields: [senderId], references: [id])
  tags        Tag[]
  logEntries  LogEntry[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model LogEntry {
  id             String       @id @default(uuid())
  body           String
  transmissionId String
  transmission   Transmission @relation(fields: [transmissionId], references: [id])
  officerId      String
  officer        User         @relation("OfficerLogEntries", fields: [officerId], references: [id])
  createdAt      DateTime     @default(now())
}
